# ── MySQL ────────────────────────────────────────────────
MYSQL_DATABASE=apartment_db
MYSQL_USER=apartment
MYSQL_PASSWORD=apartment
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3307

# ── Redis (cache + rate limit) ──────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_pw

# ── MailHog (local SMTP catcher — see sent emails) ──────
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ── Backend ─────────────────────────────────────────────
BACKEND_PORT=8080
JWT_SECRET=please-change-this-32-byte-dev-secret-xxxxxxxx
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# ── Frontend ────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Nginx (prod profile only) ───────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Mock OAuth2 (dev only) ──────────────────────────────
MOCK_OAUTH_PORT=9000

SPRING_PROFILES_ACTIVE=docker,mock-oauth