<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      023 - Nominal utility charges for flats WITHOUT a meter.
      When a flat has no electricity/water meter mapped, the owner may charge a fixed
      monthly amount instead. Two separate fields (electricity + water) per the chosen default.
    -->
    <changeSet id="023-flat-nominal-charges" author="apartment-saas">
        <addColumn tableName="flats">
            <column name="nominal_electricity_amount" type="DECIMAL(12,2)"/>
            <column name="nominal_water_amount" type="DECIMAL(12,2)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
