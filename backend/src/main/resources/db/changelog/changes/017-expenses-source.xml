<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Phase 3: tag expenses with their origin so the Expenses dashboard can
         label and deep-link auto-created utility expenses. -->
    <changeSet id="017-expenses-source" author="apartment-saas">
        <addColumn tableName="expenses">
            <column name="source" type="VARCHAR(20)" defaultValue="MANUAL"/>
            <column name="source_ref_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
