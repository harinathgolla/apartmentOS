<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Phase 5: owner/common-area electricity. Paid by the owner, recorded as an
         Expense, and optionally recoverable via tenant maintenance. -->
    <changeSet id="016-create-common-meter-readings" author="apartment-saas">
        <createTable tableName="common_meter_readings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="apartment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="label" type="VARCHAR(255)"/>
            <column name="year" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="month" type="VARCHAR(12)">
                <constraints nullable="false"/>
            </column>
            <column name="previous_reading" type="DECIMAL(12,2)" defaultValueNumeric="0"/>
            <column name="present_reading" type="DECIMAL(12,2)" defaultValueNumeric="0"/>
            <column name="usage_units" type="DECIMAL(12,2)"/>
            <column name="rate_per_unit" type="DECIMAL(8,2)"/>
            <column name="bill_amount" type="DECIMAL(12,2)"/>
            <column name="recover_from_tenants" type="BIT" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="expense_id" type="BIGINT"/>
            <column name="created_by" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="common_meter_readings" baseColumnNames="apartment_id"
                                 referencedTableName="apartments" referencedColumnNames="id"
                                 constraintName="fk_cmeter_apartment" onDelete="CASCADE"/>
        <createIndex tableName="common_meter_readings" indexName="idx_cmeter_apt_ym">
            <column name="apartment_id"/>
            <column name="year"/>
            <column name="month"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
