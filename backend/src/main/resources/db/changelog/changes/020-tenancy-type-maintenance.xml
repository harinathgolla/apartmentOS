<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      020 - Tenancy type + maintenance amount.
      tenancy_type = RENTAL (monthly, ~11-month agreement) | LEASE (locked term, e.g. 3/5 years).
      maintenance_amount = monthly maintenance stated separately in the agreement.
    -->
    <changeSet id="020-tenancy-type-maintenance" author="apartment-saas">
        <addColumn tableName="tenancies">
            <column name="tenancy_type" type="VARCHAR(20)" defaultValue="RENTAL"/>
            <column name="maintenance_amount" type="DECIMAL(12,2)" defaultValueNumeric="0"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
