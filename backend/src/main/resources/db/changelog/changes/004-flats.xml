<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="004-create-flats" author="apartment-saas">
        <createTable tableName="flats">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="apartment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="flat_no" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="floor" type="INT"/>
            <column name="area_sqft" type="DECIMAL(10,2)"/>
            <column name="bedrooms" type="INT"/>
            <column name="meter_serial_no" type="VARCHAR(50)"/>
            <column name="owner_name" type="VARCHAR(255)"/>
            <column name="owner_phone" type="VARCHAR(32)"/>
            <column name="owner_share_pct" type="DECIMAL(5,2)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="flats" baseColumnNames="apartment_id"
                                 referencedTableName="apartments" referencedColumnNames="id"
                                 constraintName="fk_flats_apartment" onDelete="CASCADE"/>
        <addUniqueConstraint tableName="flats" columnNames="apartment_id, flat_no"
                             constraintName="uk_flats_apt_flatno"/>
    </changeSet>

</databaseChangeLog>
