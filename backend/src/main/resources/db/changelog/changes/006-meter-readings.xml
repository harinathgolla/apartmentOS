<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="006-create-meter-readings" author="apartment-saas">
        <createTable tableName="meter_readings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="flat_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="apartment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="year" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="month" type="VARCHAR(12)">
                <constraints nullable="false"/>
            </column>
            <column name="previous_reading" type="DECIMAL(12,2)" defaultValueNumeric="0"/>
            <column name="present_reading" type="DECIMAL(12,2)" defaultValueNumeric="0"/>
            <column name="usage_units" type="DECIMAL(12,2)"/>
            <column name="rate_per_unit" type="DECIMAL(8,2)"/>
            <column name="bill_amount" type="DECIMAL(12,2)"/>
            <column name="reading_date" type="DATE"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="meter_readings" baseColumnNames="flat_id"
                                 referencedTableName="flats" referencedColumnNames="id"
                                 constraintName="fk_meter_flat" onDelete="CASCADE"/>
        <addUniqueConstraint tableName="meter_readings" columnNames="flat_id, year, month"
                             constraintName="uk_meter_flat_ym"/>
    </changeSet>

</databaseChangeLog>
