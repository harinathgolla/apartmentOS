<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      025 - Liability settlements ledger.
      Records refunds/repayments the owner makes against a refundable liability
      (SECURITY_DEPOSIT or LEASE_UPFRONT). Never treated as rent.
    -->
    <changeSet id="025-liability-settlements" author="apartment-saas">
        <createTable tableName="liability_settlements">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenancy_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="apartment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="kind" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(12,2)" defaultValueNumeric="0"/>
            <column name="settled_date" type="DATE"/>
            <column name="notes" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="liability_settlements" baseColumnNames="tenancy_id"
                                 referencedTableName="tenancies" referencedColumnNames="id"
                                 constraintName="fk_liabset_tenancy" onDelete="CASCADE"/>
        <createIndex tableName="liability_settlements" indexName="idx_liabset_apt">
            <column name="apartment_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
