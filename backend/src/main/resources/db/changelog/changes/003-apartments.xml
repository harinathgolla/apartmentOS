<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="003-create-apartments" author="apartment-saas">
        <createTable tableName="apartments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="org_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="address" type="VARCHAR(500)"/>
            <column name="city" type="VARCHAR(120)"/>
            <column name="state" type="VARCHAR(120)"/>
            <column name="pincode" type="VARCHAR(12)"/>
            <column name="total_floors" type="INT"/>
            <column name="purchase_value" type="DECIMAL(14,2)"/>
            <column name="purchase_date" type="DATE"/>
            <column name="loan_amount" type="DECIMAL(14,2)"/>
            <column name="loan_emi" type="DECIMAL(12,2)"/>
            <column name="loan_interest_rate" type="DECIMAL(5,2)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="apartments" baseColumnNames="org_id"
                                 referencedTableName="orgs" referencedColumnNames="id"
                                 constraintName="fk_apartments_org" onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
