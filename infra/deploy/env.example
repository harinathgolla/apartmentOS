# Template for /opt/apartmentos/.env
# The real .env is generated on the host by start.sh from SSM Parameter Store
# and chmod 600. Never commit an actual .env file.

SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:mysql://apartmentos-mysql.cfm28044y72p.ap-south-2.rds.amazonaws.com:3306/apartment_db?useSSL=true&requireSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=apartment
SPRING_DATASOURCE_PASSWORD=<from SSM /apartmentos/dev/db/password>
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
APP_MAIL_PROVIDER=gmail-api
# Browser-facing base URL. start.sh sets this to https://<detected-public-ip>,
# or to https://<APARTMENTOS_HOSTNAME> when that variable is set on the host.
APP_FRONTEND_URL=https://<public-ip-or-hostname>
JWT_SECRET=<from SSM /apartmentos/dev/jwt/secret>
# Optional: a DNS name that points at this host. When set, the cert gets an
# additional DNS SAN and APP_FRONTEND_URL uses it instead of the raw IP.
# APARTMENTOS_HOSTNAME=app.example.com
